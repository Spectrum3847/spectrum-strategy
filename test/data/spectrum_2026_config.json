  "sections": [
    {
      "name": "Prematch",
      "fields": [
        {
          "title": "Scouter Name",
          "description": "Enter the full first name and last initial of the scouter without spaces. Ex. JohnD",
          "type": "text",
          "required": true,
          "code": "scouter",
          "formResetBehavior": "preserve",
          "defaultValue": ""
        },
        {
          "title": "Match Number",
          "description": "Enter the match number.",
          "type": "number",
          "required": true,
          "code": "matchNumber",
          "formResetBehavior": "increment",
          "defaultValue": 1
        },
        {
          "title": "Robot Driver Station",
          "description": "The driver station of the robot you are scouting this match. DO NOT CHANGE (same as sticker)",
          "type": "select",
          "required": true,
          "code": "robot",
          "formResetBehavior": "preserve",
          "defaultValue": "R1",
          "choices": {
            "Red 1": "R1",
            "Red 2": "R2",
            "Red 3": "R3",
            "Blue 1": "B1",
            "Blue 2": "B2",
            "Blue 3": "B3"
          }
        },
        {
          "title": "Team Number",
          "description": "The team number of the robot you are scouting.",
          "type": "number",
          "required": true,
          "code": "pTnumber",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 1,
          "max": 19999
        }
      ]
    },
    {
      "name": "Autonomous",
      "fields": [
        {
          "title": "Robot Starting Position",
          "description": "The starting position of the robot on the field.",
          "type": "select",
          "required": true,
          "code": "starting",
          "formResetBehavior": "reset",
          "defaultValue": "",
          "choices": {
            "No Show": "No Show",
            "Depot Trench": "Depot Trench",
            "Outpost Trench": "Outpost Trench",
            "Depot Bump": "Depot Bump",
            "Oupost Bump": "Oupost Bump",
            "Center hub": "Center Hub"
          }
        },
        {
          "title": "Fuel Scored",
          "description": "Approximate fuel scored during autonomous.",
          "type": "multi-counter",
          "required": false,
          "code": "autoFuelScored",
          "formResetBehavior": "reset",
          "defaultValue": 0
        },
        {
          "title": "Level 1 Climb",
          "description": "Select if the robot succeeded, failed, or did not attempt to climb the tower. A climb is successful if the robot is off the ground.",
          "type": "select",
          "required": false,
          "code": "auLow",
          "formResetBehavior": "reset",
          "defaultValue": "N/A",
          "choices": {
            "N/A": "Not Attempted",
            "Failed": "Failed",
            "Successful": "Successful"
          }
        }
      ]
    },
    {
      "name": "Teleop",
      "fields": [
        {
          "title": "Fuel Scored",
          "description": "Approximate fuel scored during autonomous.",
          "type": "multi-counter",
          "required": false,
          "code": "teleopFuelScored",
          "formResetBehavior": "reset",
          "defaultValue": 0
        },
        {
          "title": "Scoring Accuracy(%)",
          "description": "Rate the robot's scoring accuracy.",
          "type": "range",
          "required": false,
          "code": "scoringEff",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "title": "defense",
          "description": "Check if the robot has played defense on robots.",
          "type": "boolean",
          "required": false,
          "code": "tRdefense",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "passer/pusher",
          "description": "Check if the robot passes and/or pushes fuel to their alliance partner from the neutral zone.",
          "type": "boolean",
          "required": false,
          "code": "tRpasser",
          "formResetBehavior": "reset",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Endgame",
      "fields": [
        {
          "title": "Climb position",
          "description": "Select the position of the robot climb.",
          "type": "select",
          "required": false,
          "code": "ePclimb",
          "formResetBehavior": "reset",
          "defaultValue": "N/A",
          "choices": {
            "N/A": "Not Attempted",
            "Outpost": "Outpost",
            "Middle": "Middle",
            "Depot": "Depot"
          }
        },
        {
          "title": "Low Climb(L1)",
          "description": "Select if the robot succeeded, failed, or did not attempt to climb the low positiion in the tower. A low climb is successful if the robot is off the ground after 3 seconds after the match ends.",
          "type": "select",
          "required": false,
          "code": "eLow",
          "formResetBehavior": "reset",
          "defaultValue": "N/A",
          "choices": {
            "N/A": "Not Attempted",
            "Failed": "Failed",
            "Successful": "Successful"
          }
        },
        {
          "title": "Middle Climb(L2)",
          "description": "Select if the robot succeeded, failed, or did not attempt to climb the low positiion in the tower. A middlen climb is successful if the robot is above the second rung of the tower after 3 secodns after the match ends.",
          "type": "select",
          "required": false,
          "code": "eMiddle",
          "formResetBehavior": "reset",
          "defaultValue": "N/A",
          "choices": {
            "N/A": "Not Attempted",
            "Failed": "Failed",
            "Successful": "Successful"
          }
        },
        {
          "title": "High Climb(L3)",
          "description": "Select if the robot succeeded, failed, or did not attempt to climb the high position in the tower. A high climb is successful if the robot is above the third rung of the tower after 3 seconds after the match ends.",
          "type": "select",
          "required": false,
          "code": "eHigh",
          "formResetBehavior": "reset",
          "defaultValue": "N/A",
          "choices": {
            "N/A": "Not Attempted",
            "Failed": "Failed",
            "Successful": "Successful"
          }
        },
        {
          "title": "Yellow/Red Card",
          "description": "Check if the robot recieved a yellow or red card",
          "type": "boolean",
          "required": false,
          "code": "RYcard",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "disconnect/die",
          "description": "Check if the robot died or disconnected during the match.",
          "type": "boolean",
          "required": false,
          "code": "Diecard",
          "formResetBehavior": "reset",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Postmatch",
      "fields": [
        {
          "title": "Comments",
          "type": "text",
          "required": false,
          "code": "comments",
          "formResetBehavior": "reset",
          "defaultValue": ""
        }
      ]
    }
  ]
}