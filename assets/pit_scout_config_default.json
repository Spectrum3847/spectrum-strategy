        {
          "title": "Programming Language",
          "description": "Primary programming language used.",
          "type": "select",
          "required": false,
          "code": "programmingLang",
          "formResetBehavior": "reset",
          "defaultValue": "java",
          "choices": {
            "java": "Java",
            "cpp": "C++",
            "python": "Python",
            "labview": "LabVIEW",
            "other": "Other"
          }
        }
      ]
    },
    {
