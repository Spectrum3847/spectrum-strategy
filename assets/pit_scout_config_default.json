{
  "title": "Pit Scouting",
  "page_title": "Robot Inspection",
  "delimiter": "\t",
  "revision": 1,
  "sections": [
    {
      "name": "Drivetrain",
      "fields": [
        {
          "title": "Drivetrain Type",
          "description": "The type of drivetrain used by this robot.",
          "type": "select",
          "required": true,
          "code": "drivetrainType",
          "formResetBehavior": "reset",
          "defaultValue": "tank",
          "choices": {
            "tank": "Tank / Skid Steer",
            "swerve": "Swerve",
            "mecanum": "Mecanum",
            "omni": "Omni",
            "other": "Other"
          }
        },
        {
          "title": "Drive Motor",
          "description": "Primary drive motor type.",
          "type": "select",
          "required": false,
          "code": "driveMotor",
          "formResetBehavior": "reset",
          "defaultValue": "neo",
          "choices": {
            "neo": "NEO",
            "falcon": "Falcon 500",
            "kraken": "Kraken X60",
            "cim": "CIM",
            "minicim": "Mini CIM",
            "other": "Other"
          }
        },
        {
          "title": "Weight (lbs)",
          "description": "Approximate robot weight in pounds.",
          "type": "number",
          "required": false,
          "code": "weightLbs",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 200
        },
        {
          "title": "Frame Dimensions",
          "description": "Frame perimeter dimensions, e.g. 28x30.",
          "type": "text",
          "required": false,
          "code": "frameDimensions",
          "formResetBehavior": "reset",
          "defaultValue": ""
        },
        {
          "title": "Can they fit under the trench?",
          "description": "Yes if the robot fits under the trench, no if it plays over the bump.",
          "type": "boolean",
          "required": false,
          "code": "trenchFit",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "Launcher Type",
          "description": "Launcher type, for the match info Robot Type column (#1385).",
          "type": "text",
          "required": false,
          "code": "launcherType",
          "formResetBehavior": "reset",
          "defaultValue": ""
        }
      ]
    },
    {
      "name": "Capabilities",
      "fields": [
        {
          "title": "Can Climb",
          "description": "Can the robot climb at the end of the match?",
