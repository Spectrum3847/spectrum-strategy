          "required": false,
          "code": "canClimb",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "Climb Height",
          "description": "Maximum climb height this robot can achieve.",
          "type": "select",
          "required": false,
          "code": "climbHeight",
          "formResetBehavior": "reset",
          "defaultValue": "none",
          "choices": {
            "none": "None",
            "low": "Low",
            "medium": "Medium",
            "high": "High"
          }
        },
        {
          "title": "Can Score",
          "description": "Can the robot score game pieces?",
          "type": "boolean",
          "required": false,
          "code": "canScore",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "Autonomous Routines",
          "description": "Number of autonomous routines available.",
          "type": "counter",
          "required": false,
          "code": "autoRoutines",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 20,
          "buttons": [1]
