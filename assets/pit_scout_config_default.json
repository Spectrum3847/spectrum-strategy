        {
          "title": "Additional Notes",
          "description": "Anything else worth knowing about this robot.",
          "type": "text",
          "required": false,
          "code": "additionalNotes",
          "formResetBehavior": "reset",
          "defaultValue": ""
        }
      ]
    }
  ]
}
