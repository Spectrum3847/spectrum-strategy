# Copy to .env to override. Every value has a default in the code.

# Public name this app is registered under on the central sign-in (not a secret).
# VITE_SPECTRUM_APP_KEY=spectrumstrategy

# Show the dev-only outbox proof buttons in Settings in a build. Always on in `pnpm dev`.
# VITE_OUTBOX_PROOF=true

# The Web Push public key and the Worker that sends reminders (neither is a secret).
# VITE_VAPID_PUBLIC_KEY=
# VITE_PUSH_WORKER_URL=https://spectrumstrategy-crons.spectrum-3847.workers.dev
